<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  
  <ItemGroup>
	<PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.5" />
	<PackageVersion Include="AssemblyMetadata.Generators" Version="2.2.0" />
	<PackageVersion Include="Immediate.Apis" Version="6.5.0" />
	<PackageVersion Include="Immediate.Handlers" Version="4.3.0" />
	<PackageVersion Include="Immediate.Validations" Version="3.8.0" />
	<PackageVersion Include="linq2db" Version="6.5.1" />
	<PackageVersion Include="linq2db.Extensions" Version="6.5.1" />
	<PackageVersion Include="MessagePack" Version="3.1.12" />
	<PackageVersion Include="Meziantou.Framework.Scheduling" Version="4.1.6" />
	<PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.14" />
	<PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
	<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
	<PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
	<PackageVersion Include="NodaTime" Version="3.3.7" />
	<PackageVersion Include="NodaTime.Serialization.SystemTextJson" Version="1.4.0" />
	<PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
	<PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
	<PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
	<PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
	<PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
	<PackageVersion Include="Scalar.AspNetCore" Version="2.20.0" />
	<PackageVersion Include="Scriban" Version="7.6.1" />
	<PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
	<PackageVersion Include="StackExchange.Redis" Version="3.4.31" />
	<PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
	<PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
	<PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
	<PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
	<PackageVersion Include="Verify.SourceGenerators" Version="2.5.0" />
	<PackageVersion Include="Verify.XunitV3" Version="33.3.4" />
	<PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>
  
  <!-- IJ.Shared dependencies -->
  <PropertyGroup>
	<Net10PackageVersion>10.0.15</Net10PackageVersion>
	<Net11PackageVersion>11.0.0</Net11PackageVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
	<PackageVersion Include="Basic.Reference.Assemblies.Net110" Version="1.8.15" />
	<PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="$(Net11PackageVersion)" />
	<PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="11.0.100" />
	<!-- Keep EF Core aligned with Npgsql 11 RC3 until its stable provider is published. -->
	<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0-rc.3.26522.148" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0-rc.3.26522.148" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-rc.3.26522.148" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0-rc.3.26522.148" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.3.26522.148" />
	<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(Net11PackageVersion)" />
	<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(Net11PackageVersion)" />
	<PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="$(Net11PackageVersion)" />
	<PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(Net11PackageVersion)" />
	<PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(Net11PackageVersion)" />
	<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(Net11PackageVersion)" />
	<PackageVersion Include="Microsoft.Extensions.Options" Version="$(Net11PackageVersion)" />
	<PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
	<PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.3" />
	<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(Net11PackageVersion)" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
	<PackageVersion Include="Basic.Reference.Assemblies.Net100" Version="1.8.15" />
	<PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="$(Net10PackageVersion)" />
	<PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.404" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(Net10PackageVersion)" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(Net10PackageVersion)" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(Net10PackageVersion)" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(Net10PackageVersion)" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(Net10PackageVersion)" />
	<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(Net10PackageVersion)" />
	<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(Net10PackageVersion)" />
	<PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="$(Net10PackageVersion)" />
	<PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(Net10PackageVersion)" />
	<PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(Net10PackageVersion)" />
	<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(Net10PackageVersion)" />
	<PackageVersion Include="Microsoft.Extensions.Options" Version="$(Net10PackageVersion)" />
	<PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
	<PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
	<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(Net10PackageVersion)" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
	<PackageVersion Include="Basic.Reference.Assemblies.Net80" Version="1.8.15" />
	<PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.34" />
	<PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="8.0.0" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.34" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.34" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.34" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.34" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.34" />
	<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
	<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
	<PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.34" />
	<PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
	<PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
	<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
	<PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
	<PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.10.0" />
	<PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
	<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.23" />
  </ItemGroup>
  
  <!-- IJ.Generators dependencies -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net11.0' or '$(TargetFramework)' == 'roslyn5.9' ">
	<PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
	<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
	<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'roslyn5.0' ">
	<PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.0.0" />
	<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
	<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="4.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'roslyn4.8' ">
	<PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="4.8.0" />
	<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
	<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
  </ItemGroup>
  
  <ItemGroup>
	<GlobalPackageReference Include="DotNet.ReproducibleBuilds" Version="2.0.5" PrivateAssets="All" />
	<GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.324" PrivateAssets="All" />
	<GlobalPackageReference Include="Meziantou.Polyfill" Version="1.0.171" PrivateAssets="All" />
	<GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
	<GlobalPackageReference Include="MinVer" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>
  
</Project>
