<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <NoWarn>$(NoWarn);CS1591;CA1050;CA1848;CA1873</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Immediate.Handlers" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="../ServiceDefaults/Immediate.Jobs.DistributedAspire.ServiceDefaults.csproj" />
    <ProjectReference Include="..\DistributedAspire.Shared\Immediate.Jobs.DistributedAspire.Shared.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <RoslynVersion Condition=" '$(TargetFramework)' == 'net8.0' ">roslyn4.8</RoslynVersion>
    <RoslynVersion Condition=" '$(TargetFramework)' == 'net10.0' ">roslyn5.0</RoslynVersion>
    <RoslynVersion Condition=" '$(TargetFramework)' == 'net11.0' ">roslyn5.9</RoslynVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Immediate.Jobs.Dashboard/Immediate.Jobs.Dashboard.csproj" />
    
    <ProjectReference Include="../../../src/Immediate.Jobs.Analyzers/Immediate.Jobs.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false">
      <SetTargetFramework>TargetFramework=$(RoslynVersion)</SetTargetFramework>
    </ProjectReference>

    <ProjectReference Include="../../../src/Immediate.Jobs.Generators/Immediate.Jobs.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false">
      <SetTargetFramework>TargetFramework=$(RoslynVersion)</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>
</Project>
