<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Nuget">
	<IsPackable>true</IsPackable>
	<IncludeBuildOutput>false</IncludeBuildOutput>

	<Title>Immediate.Jobs</Title>
	<Description>A reflection-free background job scheduler for .NET using source generation.</Description>
	<PackageTags>background-jobs;scheduler;source-generator;aot</PackageTags>
  </PropertyGroup>

  <!--
	This ensures the library will be packaged as a source generator when we use `dotnet pack`
	-->
  <ItemGroup>
	<None Include="../../readme.md" Pack="true" PackagePath="/" />

	<!-- IJ.Shared -->
	<TfmSpecificPackageFile
	  Include="../Immediate.Jobs.Shared/bin/$(Configuration)/$(TargetFramework)/Immediate.Jobs.Shared.dll"
	  Pack="true"
	  PackagePath="lib/$(TargetFramework)" />

	<TfmSpecificPackageFile
	  Include="../Immediate.Jobs.Shared/bin/$(Configuration)/$(TargetFramework)/Immediate.Jobs.Shared.xml"
	  Pack="true"
	  PackagePath="lib/$(TargetFramework)" />
  </ItemGroup>

  <ItemGroup>
	<None
	  Include="../Immediate.Jobs.Analyzers/bin/$(Configuration)/roslyn4.8/Immediate.Jobs.Analyzers.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn4.8/cs" />

	<None
	  Include="../Immediate.Jobs.Generators/bin/$(Configuration)/roslyn4.8/Immediate.Jobs.Generators.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn4.8/cs" />

	<TfmSpecificPackageFile
	  Condition=" '$(TargetFramework)' == 'net8.0' "
	  Include="$(PkgMeziantou_Framework_Scheduling)/lib/netstandard2.0/Meziantou.Framework.Scheduling.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn4.8/cs" />
  </ItemGroup>

  <ItemGroup>
	<None
	  Include="../Immediate.Jobs.Analyzers/bin/$(Configuration)/roslyn5.0/Immediate.Jobs.Analyzers.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.0/cs" />

	<None
	  Include="../Immediate.Jobs.Generators/bin/$(Configuration)/roslyn5.0/Immediate.Jobs.Generators.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.0/cs" />

	<TfmSpecificPackageFile
	  Condition=" '$(TargetFramework)' == 'net8.0' "
	  Include="$(PkgScriban)/lib/net8.0/Scriban.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.0/cs" />

	<TfmSpecificPackageFile
	  Condition=" '$(TargetFramework)' == 'net8.0' "
	  Include="$(PkgMeziantou_Framework_Scheduling)/lib/net10.0/Meziantou.Framework.Scheduling.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.0/cs" />
  </ItemGroup>

  <ItemGroup>
	<None
	  Include="../Immediate.Jobs.Analyzers/bin/$(Configuration)/roslyn5.9/Immediate.Jobs.Analyzers.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.9/cs" />

	<None
	  Include="../Immediate.Jobs.Generators/bin/$(Configuration)/roslyn5.9/Immediate.Jobs.Generators.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.9/cs" />

	<TfmSpecificPackageFile
	  Condition=" '$(TargetFramework)' == 'net8.0' "
	  Include="$(PkgScriban)/lib/net8.0/Scriban.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.9/cs" />

	<TfmSpecificPackageFile
	  Condition=" '$(TargetFramework)' == 'net8.0' "
	  Include="$(PkgMeziantou_Framework_Scheduling)/lib/net10.0/Meziantou.Framework.Scheduling.dll"
	  Pack="true"
	  PackagePath="analyzers/dotnet/roslyn5.9/cs" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Immediate.Handlers" />
	<PackageReference Include="Immediate.Validations" />
	<PackageReference Include="Meziantou.Framework.Scheduling" GeneratePathProperty="true" />
	<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" NoWarn="NU5104" />
	<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" NoWarn="NU5104" />
	<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" NoWarn="NU5104" />
	<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" NoWarn="NU5104" />
	<PackageReference Include="Scriban" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="../Immediate.Jobs.Shared/Immediate.Jobs.Shared.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
	<RoslynVersion Condition=" '$(TargetFramework)' == 'net8.0' ">roslyn4.8</RoslynVersion>
	<RoslynVersion Condition=" '$(TargetFramework)' == 'net10.0' ">roslyn5.0</RoslynVersion>
	<RoslynVersion Condition=" '$(TargetFramework)' == 'net11.0' ">roslyn5.9</RoslynVersion>
  </PropertyGroup>

  <ItemGroup>
	<ProjectReference Include="../../src/Immediate.Jobs.Analyzers/Immediate.Jobs.Analyzers.csproj" ReferenceOutputAssembly="false">
	  <SetTargetFramework>TargetFramework=$(RoslynVersion)</SetTargetFramework>
	</ProjectReference>

	<ProjectReference Include="../../src/Immediate.Jobs.Generators/Immediate.Jobs.Generators.csproj" ReferenceOutputAssembly="false">
	  <SetTargetFramework>TargetFramework=$(RoslynVersion)</SetTargetFramework>
	</ProjectReference>
  </ItemGroup>

</Project>
