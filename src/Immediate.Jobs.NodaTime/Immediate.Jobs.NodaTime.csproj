<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Title>Immediate.Jobs.NodaTime</Title>
    <Description>NodaTime scheduling overloads and JSON serialization for Immediate.Jobs.</Description>
    <Authors>Immediate.Jobs Developers</Authors>
    <Copyright>© 2026 Immediate.Jobs Developers</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageTags>background-jobs;scheduler;nodatime</PackageTags>
    <RepositoryUrl>https://github.com/ImmediatePlatform/Immediate.Jobs</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Immediate.Jobs.Shared" />
    <ProjectReference Include="../Immediate.Jobs.Shared/Immediate.Jobs.Shared.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Immediate.Jobs/Immediate.Jobs.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="NodaTime.Serialization.SystemTextJson" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../readme.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
