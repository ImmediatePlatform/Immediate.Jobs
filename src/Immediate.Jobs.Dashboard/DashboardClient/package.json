{
	"name": "immediate-jobs-dashboard",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"lint": "eslint .",
		"typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
		"test": "vitest run",
		"check": "npm run lint && npm run typecheck && npm test",
		"build": "npm run typecheck && vite build",
		"size": "node scripts/check-bundle-size.mjs"
	},
	"dependencies": {
		"@lucide/vue": "^1.72.0",
		"@tanstack/vue-query": "^5.107.1",
		"@vueuse/core": "^15.0.0",
		"@vueuse/router": "^15.0.0",
		"vue": "^3.5.45",
		"vue-router": "^5.5.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.3.5",
		"@tsconfig/node22": "^22.0.6",
		"@types/node": "^26.6.6",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vue/test-utils": "^2.5.1",
		"@vue/tsconfig": "^0.9.1",
		"eslint": "^10.14.0",
		"eslint-plugin-vue": "^10.12.1",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"vue-tsc": "^3.3.14"
	}
