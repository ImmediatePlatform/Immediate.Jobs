<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Nuget">
	<IsPackable>true</IsPackable>
	
    <Title>Immediate.Jobs.Dashboard</Title>
    <Description>Embedded monitoring dashboard and stable HTTP API for Immediate.Jobs.</Description>
	<PackageTags>background-jobs;scheduler;dashboard;monitoring</PackageTags>
  </PropertyGroup>

  <ItemGroup Label="Nuget">
	<None Include="readme.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
	<Features>runtime-async=on</Features>
  </PropertyGroup>

  <PropertyGroup>
	<DashboardClientDirectory>$(MSBuildProjectDirectory)/DashboardClient</DashboardClientDirectory>
	<DashboardAssetsDirectory>$(MSBuildProjectDirectory)/Assets</DashboardAssetsDirectory>
	<DashboardBuildStamp>$(BaseIntermediateOutputPath)dashboard-client-build.stamp</DashboardBuildStamp>
  </PropertyGroup>

  <ItemGroup>
	<DashboardClientSource Include="$(MSBuildProjectFullPath)" />
	<DashboardClientSource Include="$(DashboardClientDirectory)/index.html" />
	<DashboardClientSource Include="$(DashboardClientDirectory)/package.json" />
	<DashboardClientSource Include="$(DashboardClientDirectory)/package-lock.json" />
	<DashboardClientSource Include="$(DashboardClientDirectory)/src/**" />
	<DashboardClientSource Include="$(DashboardClientDirectory)/tsconfig*.json" />
	<DashboardClientSource Include="$(DashboardClientDirectory)/vite.config.ts" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Immediate.Jobs.Shared" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Immediate.Apis" />
	<PackageReference Include="Immediate.Validations" />
	<FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="../Immediate.Jobs.Shared/Immediate.Jobs.Shared.csproj" PrivateAssets="all" />
	<ProjectReference Include="../Immediate.Jobs/Immediate.Jobs.csproj" />
  </ItemGroup>

  <Target Name="RestoreDashboardClient"
	Inputs="$(DashboardClientDirectory)/package.json;$(DashboardClientDirectory)/package-lock.json"
	Outputs="$(DashboardClientDirectory)/node_modules/.package-lock.json">
	<Exec Command="npm ci" WorkingDirectory="$(DashboardClientDirectory)" />
  </Target>

  <Target Name="BuildDashboardClient"
	BeforeTargets="DispatchToInnerBuilds;PrepareForBuild"
	DependsOnTargets="RestoreDashboardClient"
	Inputs="@(DashboardClientSource)"
	Outputs="$(DashboardBuildStamp);$(DashboardAssetsDirectory)/app.js;$(DashboardAssetsDirectory)/app.css;$(DashboardAssetsDirectory)/index.html"
	Condition="'$(DesignTimeBuild)' != 'true'">
	<Exec Command="npm run build" WorkingDirectory="$(DashboardClientDirectory)" />
	<Exec Command="npm run size" WorkingDirectory="$(DashboardClientDirectory)" />
	<MakeDir Directories="$(BaseIntermediateOutputPath)" />
	<Touch Files="$(DashboardBuildStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="IncludeDashboardAssets"
	BeforeTargets="AssignTargetPaths"
	DependsOnTargets="BuildDashboardClient"
	Condition="'$(IsCrossTargetingBuild)' != 'true'">
	<ItemGroup>
	  <EmbeddedResource Include="$(DashboardAssetsDirectory)/app.js"
		LogicalName="$(RootNamespace).Assets.app.js" />
	  <EmbeddedResource Include="$(DashboardAssetsDirectory)/app.css"
		LogicalName="$(RootNamespace).Assets.app.css" />
	  <EmbeddedResource Include="$(DashboardAssetsDirectory)/index.html"
		LogicalName="$(RootNamespace).Assets.index.html" />
	</ItemGroup>
  </Target>
  
</Project>
